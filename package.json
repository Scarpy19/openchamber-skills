{
  "name": "openchamber-skills",
  "version": "1.1.1",
  "private": true,
  "type": "module",
  "description": "Skills Manager for OpenChamber: toggle OpenCode skills and resolve entry conflicts.",
  "openchamber": {
    "apiVersion": 1,
    "engines": {
      "openchamber": ">=2.7.0"
    },
    "contributes": {
      "panel": {
        "id": "skills-manager",
        "name": "Skills Manager",
        "icon": "list-check-2",
        "entry": "panel/index.html"
      },
      "service": {
        "entry": "service/main.js",
        "runtime": "host",
        "permissions": {}
      }
    }
  },
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "preview": "node scripts/preview.mjs",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build",
    "test": "node --experimental-strip-types --test \"tests/*.test.*\""
  },
  "devDependencies": {
    "@openchamber/sdk": "^2.7.2",
    "@types/node": "^22.20.5",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0"
  },
  "files": [
    "panel/",
    "service/",
    "README.md"
  ],
  "dependencies": {
    "jsonc-parser": "^3.3.1"
  }
}
